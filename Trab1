#include <stdio.h>
#include <pthread.h>
#include <unistd.h>
#include <stdlib.h>
#include <stdbool.h>
#include <errno.h>
#include <sys/time.h>
#include <sys/syscall.h>

#include "chrono.c"

#define MAX_THREADS 4
#define MAX_ELEMENTOS 8000000
#define element_TYPE long long

int parallelPrefixSum_thread_id[MAX_THREADS];
int parallelPrefixSum_nThreads; // obtido na linha de comando
int parallelPrefixSum_nTotalElements;  //obtido na linha de comando

element_TYPE InputVector[MAX_ELEMENTOS];
pthread_barrier_t parallelPrefixSum_barrier;
int min(int a, int b)
{
	if ( a < b)
		return a;
	else 
		return b;
}
void *ParallelPrefixSumPth( long long *Vec, long nTotalElmts, int nThreads)
{

	int myIndex = *((long long *) Vec);
	int nElements = (parallelPrefixSum_nTotalElements+(parallelPrefixSum_nThreads - 1)) / parallelPrefixSum_nThreads;

	int first = myIndex * nElements;
	int last = min( (myIndex+1) * nElements, parallelPrefixSum_nTotalElements) - 1;
	printf("thread %d here! first = %d, last = %d nElements = %d\n", myIndex, first, last, nElements);
	element_TYPE *parcialSum = InputVector;
	while(true)
	{
		pthread_barrier_wait( &parallelPrefixSum_barrier );
		register element_TYPE myParcialSum = 0;
		for ( int i = first; i <= last; i++)
			myParcialSum += parcialSum[i];
		pthread_barrier_wait(&parallelPrefixSum_barrier);
	}
	if (myIndex == 0)
		return NULL;
	else
		pthread_exit(NULL);
	return NULL;

}
int main (int argc, char *argv[])
{
	int i;
	int nThreads;
	int nTotalElements;

	chronometer_t parallelPrefixSumTime;

	if (argc != 3)
	{
		printf ("usage: %s <nTotalElements> <nThreads>\n", argv[0]);
		return 0;
	}
	else
	{
		nThreads = atoi(argv[2]);
		if (nThreads == 0)
		{
			printf("usage: %s <nTotalElements> <nThreads>\n", argv[0]);
		}
		nTotalElements = atoi(argv[1]);
	}
	for( long i = 0; i < nTotalElements; i++ ){
		int r = rand();  // Returns a pseudo-random integer
	                     //    between 0 and RAND_MAX.
		InputVector[i] = (r % 1000) - 500;
	}
	chrono_reset(&parallelPrefixSumTime);
	chrono_start(&parallelPrefixSumTime);

	void *globalSum;
	int start_position = 0;
	element_TYPE *InVec = &InputVector[start_position];

	#define NTIMES 10

	for (int i = 0; i < NTIMES; i++)
	{
		globalSum = ParallelPrefixSumPth(InVec, nTotalElements, nThreads);
		start_position += nTotalElements;
		if ((start_position + nTotalElements) > MAX_ELEMENTOS)
			start_position = 0;
		InVec = &InputVector[start_position];
	}
	chrono_stop(&parallelPrefixSumTime);
	printf("globalSum = %lf\n", globalSum);

	chrono_reportTime(&parallelPrefixSumTime, "parallelPrefixSumTime");
	double total_time_in_secound = (double) chrono_gettotal (&parallelPrefixSumTime) / ((double)1000*1000*1000);	
	
	return 0;
}
